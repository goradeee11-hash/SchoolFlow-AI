# Copy this file to secrets.toml and fill in your key to enable online mode.
# secrets.toml is excluded from git — never commit real keys.

[openai]
api_key = "sk-..."          # your OpenAI API key
model   = "gpt-4o-mini"     # or "gpt-4o"

[gemini]
api_key = "replace-locally"
model = "gemini-2.5-flash"

[supabase]
url = "https://your-project.supabase.co"
anon_key = "your-public-anon-key"
